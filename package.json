{
  "name": "taibu-app",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "node scripts/dev-with-core-watch.mjs",
    "dev:web": "next dev",
    "build": "pnpm -C packages/core build && pnpm build:agent && next build",
    "build:agent": "node scripts/build-agent-worker.mjs",
    "agent:worker": "pnpm build:core && pnpm build:agent && node scripts/agent-worker.mjs",
    "build:packages": "pnpm -C packages/core build && pnpm -C packages/mcp build && pnpm -C packages/mcp-server build",
    "typecheck": "pnpm build:packages && tsc --noEmit --incremental false",
    "start": "next start",
    "selfhost": "node scripts/selfhost.mjs",
    "local:up": "pnpm selfhost up --project taibu-agent-1006b",
    "local:update": "pnpm selfhost up --project taibu-agent-1006b --build",
    "local:status": "pnpm selfhost status --project taibu-agent-1006b",
    "local:logs": "pnpm selfhost logs --project taibu-agent-1006b",
    "local:showcase": "node scripts/selfhost-showcase.mjs --project taibu-agent-1006b",
    "lint": "pnpm lint:code && pnpm lint:guards",
    "lint:code": "eslint .",
    "lint:guards": "node scripts/check-architecture-guards.mjs",
    "test:guards": "node --test scripts/tests/architecture-guards.test.mjs",
    "test:db": "node --require ./scripts/ts-register.cjs --test scripts/tests/postgres-contracts.test.mjs scripts/tests/db-context-contracts.test.mjs",
    "test:auth": "node scripts/test-runner.mjs scripts/tests/auth-postgrest-acceptance.test.mjs",
    "test:npm-packages": "pnpm build:packages && node --test scripts/tests/npm-package-artifacts.test.mjs scripts/tests/skill-bundle.test.mjs",
    "prepare:github-packages": "node scripts/prepare-github-package.mjs --package core --package mcp --output .release/github-packages",
    "test:github-packages": "node --test scripts/tests/prepare-github-package.test.mjs",
    "test": "node scripts/test-runner.mjs",
    "test:browser": "pnpm build:core && node scripts/tests/p5-browser-fixture.mjs",
    "verify": "node scripts/test-runner.mjs --verify",
    "build:core": "pnpm -C packages/core build",
    "build:methods": "node scripts/build-methods.mjs && pnpm build:core",
    "check:methods": "node scripts/build-methods.mjs --check",
    "eval:agent": "pnpm -C packages/core build && node scripts/eval-agent.mjs",
    "db:codegen": "node scripts/db/codegen.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.48",
    "@capacitor/android": "^8.0.1",
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@capacitor/ios": "^8.0.1",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-codemode": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@lobehub/icons": "^4.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-virtual": "^3.13.18",
    "@vercel/analytics": "^1.6.1",
    "ai": "^6.0.137",
    "html2canvas": "^1.4.1",
    "ioredis": "5.8.2",
    "ipaddr.js": "2.5.0",
    "iztro": "^2.5.4",
    "kysely": "0.29.7",
    "lucide-react": "^0.562.0",
    "lunar-javascript": "^1.7.7",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "taibu-core": "workspace:*",
    "undici": "8.11.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.27.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "kysely-codegen": "0.20.0",
    "playwright": "1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
