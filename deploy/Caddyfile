{
	# Cloudflare proxy mode: keep the real client IP from the edge.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22
		141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22
		198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13
		131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32
		2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

{$APP_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 12MB
	}

	# Maintenance switch: `/opt/taibu/maintenance/on` serves a static 503 for
	# everyone except ADMIN_IP (comma separated allow-list).
	@maintenance file /srv/maintenance/on
	handle @maintenance {
		@admin remote_ip {$ADMIN_IP}
		handle @admin {
			reverse_proxy web:3000 {
				flush_interval -1
				header_up X-Real-IP {client_ip}
			}
		}
		respond "维护中，请稍后重试" 503 {
			header Retry-After 300
			close
		}
	}

	handle {
		reverse_proxy web:3000 {
			flush_interval -1
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format console
	}
}

# If Cloudflare terminates TLS with an Origin certificate, replace the site
# address with `{$APP_DOMAIN}:443` and add:
#   tls /etc/caddy/origin.pem /etc/caddy/origin.key
# Mount those files read-only in compose.prod.yml.
