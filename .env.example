# 浏览器访问的应用 origin（无路径）；生产必须使用 HTTPS。
APP_ORIGIN=
# 仅本地明确 loopback HTTP 时可启用（需要 APP_ORIGIN 是 localhost/127.0.0.1）。
AUTH_ALLOW_INSECURE_LOCAL_HTTP=false

# 文件存储：local 写入本机卷（Docker 内为 /data/files）；s3 驱动仅预留。
FILE_STORAGE_DRIVER=local
FILE_STORAGE_ROOT=/data/files

# Redis：限流、共享缓存、BullMQ 与会话二级存储。
REDIS_URL=

# PostgreSQL。应用角色无自有权限：每个事务设置角色与 request.jwt.claims。
DATABASE_URL=
AUTH_DATABASE_URL=
DB_POOL_MAX=10
DB_APPLICATION_NAME=taibu
# 只给 migrate 容器；生产由部署脚本注入。
MIGRATOR_DATABASE_URL=

# Better Auth 会话签名密钥（>= 32 字符，openssl rand -hex 32）。
BETTER_AUTH_SECRET=

# 邮件：smtp（生产）、mailpit（本地）、log（仅单元测试；生产拒绝启动）。
EMAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Linux DO Connect OAuth
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=

# MCP 服务配置
# 仅部署 MCP 时，生产环境建议至少配置 MCP_ALLOWED_ORIGINS（不要用 *）
# 注意：不要在变量赋值后写行尾注释（例如 `MCP_ALLOWED_HOSTS=  # ...`），否则在 Docker/Compose 下可能被当作变量值的一部分。
# 绑定地址，Docker 中用 0.0.0.0
MCP_HOST=127.0.0.1
# 逗号分隔的允许 Origin 白名单（浏览器请求必填，填 * 表示允许所有 Origin）
MCP_ALLOWED_ORIGINS=
# 可选：逗号分隔的 Host 白名单
MCP_ALLOWED_HOSTS=
# 最大并发 subscriptions/listen 长连接数
MCP_MAX_SUBSCRIPTIONS=1000
# 单个 IP 最大 subscriptions/listen 长连接数
MCP_MAX_SUBSCRIPTIONS_PER_IP=3
# 单个 IP 每分钟、每 HTTP method 最大请求数
MCP_RATE_LIMIT_PER_MINUTE=120
# 反向代理后设为 true
MCP_TRUST_PROXY=false
# 可选请求日志
MCP_REQUEST_LOG=false

# 内部 API 签名，用于 Chat 跳过积分授权（自定义，可使用 openssl rand -hex 32 生成）
INTERNAL_API_SECRET=

# Dify 工作流：附件上传/搜索
DIFY_API_KEY=
DIFY_API_URL=https://api.dify.ai/v1

# 高德 Web 服务 API（出生地点解析为经度，用于真太阳时）
AMAP_WEB_SERVICE_KEY=

# AI 知识库
KNOWLEDGE_BASE_EMBEDDING_MODEL_ID=text-embedding-v4
KNOWLEDGE_BASE_RERANK_MODEL_ID=qwen3-rerank
VECTOR_SEARCH_ENABLED=false

# AI API - 统一网关
NEWAPI_BASE_URL=
NEWAPI_API_KEY=
OCTOPUS_BASE_URL=
OCTOPUS_API_KEY=

# 可选：当数据库不可用时，允许用 JSON 提供最小回退模型目录
# MINGAI_FALLBACK_MODELS_JSON=[{"id":"deepseek-v3.2","name":"DeepSeek V3.2","vendor":"deepseek","usageType":"chat"}]
# Agent 后台执行（Web 与所有 worker 使用同一组配置）
# Tavily 为空时不提供联网工具；会员权限与用户联网开关仍由服务端检查。
TAVILY_API_KEY=
# 32 字节标准 Base64，使用 openssl rand -base64 32 生成。勿提交真实值。
AGENT_CREDENTIAL_ENCRYPTION_KEY=
# 仅控制 worker 并发，不限制单任务步数、搜索次数或总时长。
AGENT_WORKER_CONCURRENCY=2
# 可选：管理员指定的外部 MCP，最多 4 个公开 HTTPS 服务，每项 tools 为明确白名单。
# tokenEnv 只引用 worker 私有环境变量；不能把 token 写在 URL 或本 JSON 中。
# AGENT_MCP_SERVERS=[{"name":"public_data","url":"https://example.com/mcp","tools":["lookup"],"tokenEnv":"PUBLIC_DATA_MCP_TOKEN"}]
AGENT_MCP_SERVERS=

# 独立关闭新上传或早报生成；已引用资料仍可读取，停用早报会退回未结算预占。
AGENT_ATTACHMENTS_ENABLED=true
DAILY_BRIEFING_ENABLED=true
# Agent 事件与 durable commit 的保留天数（worker 的 retention 任务）。
AGENT_EVENT_RETENTION_DAYS=30

# --- 生产 Compose 插值（写入 /opt/taibu/env/compose.env，不含机密）---
# LOCAL_PROJECT=taibu
# LOCAL_INSTANCE_ID=prod
# TAIBU_ENV_DIR=/opt/taibu/env
# TAIBU_IMAGE=ghcr.io/<owner>/taibu
# TAIBU_TAG=v1.0.0
# APP_DOMAIN=www.example.com
# ADMIN_IP=203.0.113.7 198.51.100.0/24   # 维护页放行；空格分隔

# --- 仅用于容器/迁移/备份的机密变量（不要写进应用 .env）---
# POSTGRES_PASSWORD=
# TAIBU_MIGRATOR_PASSWORD=
# TAIBU_APP_PASSWORD=
# TAIBU_AUTH_PASSWORD=
# TAIBU_BACKUP_PASSWORD=
# REDIS_PASSWORD=
# RESTIC_REPOSITORY=
# RESTIC_PASSWORD=
# RESTORE_ADMIN_URL=postgres://postgres:<password>@db:5432/postgres
