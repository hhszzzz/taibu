# 浏览器访问的应用 origin（无路径）；生产必须使用 HTTPS。
APP_ORIGIN=
# 仅本地明确 loopback HTTP 时可启用（需要 APP_ORIGIN 是 localhost/127.0.0.1）。
AUTH_ALLOW_INSECURE_LOCAL_HTTP=false

# 文件存储：local 写入本机卷（Docker 内为 /data/files）；s3 驱动仅预留。
FILE_STORAGE_DRIVER=local
FILE_STORAGE_ROOT=/data/files

# Redis：限流、共享缓存、BullMQ 与会话二级存储。
REDIS_URL=

# PostgreSQL。应用角色无自有权限：每个事务设置角色与 request.jwt.claims。
DATABASE_URL=
AUTH_DATABASE_URL=
DB_POOL_MAX=10
DB_APPLICATION_NAME=taibu
# 只给 db-init 容器的 DDL 连接（登录角色 taibu_schema，SET ROLE taibu_owner）。
SCHEMA_DATABASE_URL=

# Better Auth 会话签名密钥（>= 32 字符，openssl rand -hex 32）。
BETTER_AUTH_SECRET=

# 邮件。任何 SMTP 中转都能接入；EMAIL_PROVIDER 只是预设主机/端口/加密方式。
#   brevo   smtp-relay.brevo.com:587 STARTTLS
#   resend  smtp.resend.com:465 隐式 TLS
#   tencent 需自行填 SMTP_HOST（广州/香港/国际站域名不同）
#   custom  完全按下面的 SMTP_* 配置，适合自建 Postfix
#   mailpit 本地捕获；log 只记日志（生产拒绝启动）
# SMTP_USER 是中转登录名，不是主机名；SMTP_PASS 是 SMTP 密钥，不是 API key。
# SMTP_FROM 支持显示名，收件人看到的是显示名而不是地址：命理排盘 <noreply@example.com>
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Linux DO Connect OAuth
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=

# MCP 服务配置
# 仅部署 MCP 时，生产环境建议至少配置 MCP_ALLOWED_ORIGINS（不要用 *）
# 注意：不要在变量赋值后写行尾注释（例如 `MCP_ALLOWED_HOSTS=  # ...`），否则在 Docker/Compose 下可能被当作变量值的一部分。
# 绑定地址，Docker 中用 0.0.0.0
MCP_HOST=127.0.0.1
# 逗号分隔的允许 Origin 白名单（浏览器请求必填，填 * 表示允许所有 Origin）
MCP_ALLOWED_ORIGINS=
# 可选：逗号分隔的 Host 白名单
MCP_ALLOWED_HOSTS=
# 最大并发 subscriptions/listen 长连接数
MCP_MAX_SUBSCRIPTIONS=1000
# 单个 IP 最大 subscriptions/listen 长连接数
MCP_MAX_SUBSCRIPTIONS_PER_IP=3
# 单个 IP 每分钟、每 HTTP method 最大请求数
MCP_RATE_LIMIT_PER_MINUTE=120
# 反向代理后设为 true
MCP_TRUST_PROXY=false
# 可选请求日志
MCP_REQUEST_LOG=false

# 易支付（支付宝/微信，彩虹易支付 v1 协议）。商户地址、商户号、密钥三项都填才开启在线充值与在线购买套餐；
# 留空时只能用兑换码、管理员加款和余额购买套餐。异步通知地址为 {APP_ORIGIN}/api/billing/epay/notify。勿提交真实密钥。
EPAY_API_URL=
EPAY_PID=
EPAY_KEY=
# 逗号分隔的支付方式，默认 alipay,wxpay
EPAY_METHODS=

# 内部 API 签名，用于 Chat 跳过计费（自定义，可使用 openssl rand -hex 32 生成）
INTERNAL_API_SECRET=

# 高德 Web 服务 API（出生地点解析为经度，用于真太阳时）
AMAP_WEB_SERVICE_KEY=

# AI 知识库
KNOWLEDGE_BASE_EMBEDDING_MODEL_ID=text-embedding-v4
KNOWLEDGE_BASE_RERANK_MODEL_ID=qwen3-rerank
VECTOR_SEARCH_ENABLED=false

# AI 网关与模型：地址、密钥和模型目录都由管理员在设置中心「AI 服务」维护，不读取环境变量。
# 网关密钥用下方 AGENT_CREDENTIAL_ENCRYPTION_KEY 加密后存入数据库；更换该密钥后需要重新填写网关密钥。

# Agent 后台执行（Web 与所有 worker 使用同一组配置）
# 联网搜索与网页读取改由管理员在设置中心「Agent 扩展 → MCP 服务」接入的 Exa、Tavily 等 MCP 服务承担，
# 不再读取环境变量。附件文字提取在进程内完成，不需要外部服务。
# 32 字节标准 Base64，使用 openssl rand -base64 32 生成。勿提交真实值。
# 同时用于加密数据库中的 MCP 密钥（管理员与用户在设置中心填写的密钥请求头和查询参数）；
# 更换后已保存的 MCP 密钥无法解密，需要重新填写。
AGENT_CREDENTIAL_ENCRYPTION_KEY=
# 仅控制 worker 并发，不限制单任务步数、搜索次数或总时长。
AGENT_WORKER_CONCURRENCY=2
# 同一用户同时运行的任务数上限；多出的任务保持排队，前一个结束后自动开始。
AGENT_USER_CONCURRENCY=1

# 独立关闭新附件上传；已引用资料仍可读取。
AGENT_ATTACHMENTS_ENABLED=true
# Agent 事件与 durable commit 的保留天数（worker 的 retention 任务）。
AGENT_EVENT_RETENTION_DAYS=30
# 追问（awaiting_input）等待多久后先提醒模型、再次超时才结束任务（默认 5 分钟）；0 关闭。
AGENT_ASK_TIMEOUT_MINUTES=5

# --- 生产 Compose 插值（写入 /opt/taibu/env/compose.env，不含机密）---
# LOCAL_PROJECT=taibu
# LOCAL_INSTANCE_ID=prod
# TAIBU_ENV_DIR=/opt/taibu/env
# TAIBU_IMAGE=ghcr.io/<owner>/taibu
# TAIBU_TAG=v1.0.0
# APP_DOMAIN=www.example.com
# 维护页放行名单，空格分隔。
# ADMIN_IP=203.0.113.7 198.51.100.0/24
# container：本栈启动 Caddy 占 80/443；host：宿主已有 Caddy，反代 127.0.0.1:WEB_PORT。
# EDGE_MODE=container
# WEB_PORT=3000

# --- 仅用于容器/数据库初始化/备份的机密变量（不要写进应用 .env）---
# POSTGRES_PASSWORD=
# TAIBU_SCHEMA_PASSWORD=
# TAIBU_APP_PASSWORD=
# TAIBU_AUTH_PASSWORD=
# TAIBU_BACKUP_PASSWORD=
# REDIS_PASSWORD=
# RESTIC_REPOSITORY=
# RESTIC_PASSWORD=
# RESTORE_ADMIN_URL=postgres://postgres:<password>@db:5432/postgres
